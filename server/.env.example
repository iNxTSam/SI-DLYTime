# ---------------------------------------------------------------------------
# Copia este archivo como server/.env y completa los valores reales.
# Nunca subas el archivo .env al repositorio.
# ---------------------------------------------------------------------------

# Servidor
PORT=3001
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma).
# El cliente web con Vite corre en el 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seguridad / JWT
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dlytime
DB_CONNECTION_LIMIT=10

# Correo saliente (Gmail con contrasena de aplicacion)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM=SI-DLYTime <no-reply@dlytime.local>
SUPPORT_MAIL_TO=

# Carga de archivos (historial clinico en PDF)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Bloqueo de cuenta por intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
