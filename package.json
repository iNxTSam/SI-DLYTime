{
  "name": "si-dlytime",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestion de citas y historial clinico DLYTime (API + web + movil)",
  "scripts": {
    "install:all": "npm run install:server && npm run install:client && npm run install:mobile",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:mobile": "npm --prefix client_Movil install",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:mobile": "npm --prefix client_Movil start",
    "start:server": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test && npm --prefix client test",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
